{
    "compilerOptions": {
      "declaration": true,
      "declarationMap": false,
      "esModuleInterop": true,
      "importHelpers": true,
      "jsx": "preserve",
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "skipLibCheck": true,
      "sourceMap": true,
      "target": "ES2022",
      "module": "commonjs",
      "strict": true,
      "typeRoots": ["node_modules/@types"],
      "types": ["node"],
      "outDir": "./dist"
    },
    "include": ["src"],
    "exclude": ["**/*.test.ts", "**/*.spec.ts"]
  }
